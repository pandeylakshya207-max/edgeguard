#pragma once
// Generated by CMake at configure time — do not edit directly (edit
// test_config.hpp.in instead). Gives tests a reliable absolute path to
// the source tree's models/ directory regardless of the build
// directory's location or the working directory tests happen to be run
// from, instead of guessing with relative paths ("models/..." vs
// "../models/...") that break depending on how/where the test binary is
// invoked.
#define EDGEGUARD_SOURCE_DIR "@CMAKE_SOURCE_DIR@"
